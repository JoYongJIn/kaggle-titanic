{
  "name": "titanic",
  "competition": "titanic",
  "target": "Survived",
  "id_column": "PassengerId",
  "train_file": "data/train.csv",
  "test_file": "data/test.csv",
  "python": ".venv/bin/python",
  "train_script": "train.py",
  "hparams": {
    "lr": {"type": "float", "default": 0.001, "label": "학습률"},
    "epochs": {"type": "int", "default": 300, "label": "최대 에폭"},
    "batch_size": {"type": "int", "default": 64, "label": "배치 크기"},
    "hidden": {"type": "str", "default": "64,32", "label": "은닉층 (쉼표 구분)"},
    "dropout": {"type": "float", "default": 0.3, "label": "드롭아웃"},
    "weight_decay": {"type": "float", "default": 0.0001, "label": "가중치 감쇠"},
    "patience": {"type": "int", "default": 30, "label": "조기 종료 인내"},
    "val_size": {"type": "float", "default": 0.2, "label": "검증 비율"},
    "seed": {"type": "int", "default": 42, "label": "시드"}
  }
}
